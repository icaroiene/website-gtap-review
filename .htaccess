DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # A página interna da Open foi removida; a rota antiga aponta para o site oficial.
  RewriteRule ^open-solucoes-tributarias(?:/.*)?$ https://www.opensolucoestributarias.com.br/ [R=301,L,NC]
</IfModule>

# Real files/directories and existing PHP endpoints are served directly.
# No SPA fallback: each route has its own exported index.html.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|svg|mp4)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^([a-f0-9]{20}-[0-9]+\.(webp|avif)|banner-[a-f0-9]{16}\.mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
